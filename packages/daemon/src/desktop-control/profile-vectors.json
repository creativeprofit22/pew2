{
  "base": { "token": "abcdefghijklmnopqrstuvwxyzABCDEF", "key": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" },
  "cases": [
    { "name": "absent claim", "patch": {}, "expected": "ok" },
    { "name": "empty claim", "patch": { "claimedBy": "" }, "expected": "ok" },
    { "name": "ASCII claim boundary", "repeat": { "field": "claimedBy", "text": "a", "count": 256 }, "expected": "ok" },
    { "name": "BMP claim boundary", "repeat": { "field": "claimedBy", "text": "界", "count": 256 }, "expected": "ok" },
    { "name": "astral claim boundary", "repeat": { "field": "claimedBy", "text": "😀", "count": 128 }, "expected": "ok" },
    { "name": "ASCII claim over limit", "repeat": { "field": "claimedBy", "text": "a", "count": 257 }, "expected": "missing_profile" },
    { "name": "BMP claim over limit", "repeat": { "field": "claimedBy", "text": "界", "count": 257 }, "expected": "missing_profile" },
    { "name": "astral claim over limit", "repeat": { "field": "claimedBy", "text": "😀", "count": 129 }, "expected": "missing_profile" },
    { "name": "numeric claim", "patch": { "claimedBy": 42 }, "expected": "missing_profile" },
    { "name": "boolean claim", "patch": { "claimedBy": false }, "expected": "missing_profile" },
    { "name": "null claim", "patch": { "claimedBy": null }, "expected": "missing_profile" },
    { "name": "array claim", "patch": { "claimedBy": [] }, "expected": "missing_profile" },
    { "name": "object claim", "patch": { "claimedBy": {} }, "expected": "missing_profile" },
    { "name": "token maximum", "repeat": { "field": "token", "text": "_-Az09", "count": 170, "suffix": "abcd" }, "expected": "ok" },
    { "name": "token too long", "repeat": { "field": "token", "text": "a", "count": 1025 }, "expected": "missing_profile" },
    { "name": "token too short", "repeat": { "field": "token", "text": "a", "count": 31 }, "expected": "missing_profile" },
    { "name": "token newline", "repeat": { "field": "token", "text": "a", "count": 32, "suffix": "\n" }, "expected": "missing_profile" },
    { "name": "token carriage return", "repeat": { "field": "token", "text": "a", "count": 32, "suffix": "\r" }, "expected": "missing_profile" },
    { "name": "token line separator", "repeat": { "field": "token", "text": "a", "count": 32, "suffix": "\u2028" }, "expected": "missing_profile" },
    { "name": "token Unicode", "repeat": { "field": "token", "text": "界", "count": 32 }, "expected": "missing_profile" },
    { "name": "token null", "patch": { "token": null }, "expected": "missing_profile" },
    { "name": "token absent", "omit": "token", "expected": "missing_profile" },
    { "name": "uppercase key", "repeat": { "field": "key", "text": "ABCDEF01", "count": 8 }, "expected": "ok" },
    { "name": "key short", "repeat": { "field": "key", "text": "a", "count": 63 }, "expected": "missing_profile" },
    { "name": "key long", "repeat": { "field": "key", "text": "a", "count": 65 }, "expected": "missing_profile" },
    { "name": "key newline", "repeat": { "field": "key", "text": "a", "count": 64, "suffix": "\n" }, "expected": "missing_profile" },
    { "name": "key carriage return", "repeat": { "field": "key", "text": "a", "count": 64, "suffix": "\r" }, "expected": "missing_profile" },
    { "name": "key nonhex", "repeat": { "field": "key", "text": "g", "count": 64 }, "expected": "missing_profile" },
    { "name": "key null", "patch": { "key": null }, "expected": "missing_profile" },
    { "name": "key absent", "omit": "key", "expected": "missing_profile" },
    { "name": "empty relay", "patch": { "relay": "" }, "expected": "ok" },
    { "name": "configured relay", "patch": { "relay": "https://example.invalid" }, "expected": "relay_configured" },
    { "name": "null relay", "patch": { "relay": null }, "expected": "relay_configured" },
    { "name": "boolean relay", "patch": { "relay": false }, "expected": "relay_configured" },
    { "name": "legacy metadata", "patch": { "createdAt": 42, "extra": true }, "expected": "ok" },
    { "name": "array root", "root": [], "expected": "missing_profile" },
    { "name": "null root", "root": null, "expected": "missing_profile" }
  ]
}
