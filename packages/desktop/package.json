{
  "name": "@pew2/desktop",
  "version": "0.9.19",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "tauri": "tauri",
    "prepare:native": "tauri icon ../../docs/icon.png --output src-tauri/gen/icons && bun run scripts/build-daemon.ts",
    "build:installer": "bun run scripts/package.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.11",
    "typescript": "5.9.2",
    "vite": "8.3.0"
  }
}
